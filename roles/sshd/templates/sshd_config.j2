# Drop-ins win over directives below.  Used by the `hardening` role,
# which writes /etc/ssh/sshd_config.d/01-hardening.conf when applied.
Include /etc/ssh/sshd_config.d/*.conf

Port {{ sshd_port | default(22) }}
PermitRootLogin {{ sshd_permit_root | default('prohibit-password') }}
PasswordAuthentication {{ 'yes' if (sshd_password_auth | default(false)) else 'no' }}
PubkeyAuthentication yes
ChallengeResponseAuthentication no
X11Forwarding no
PrintMotd no
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/ssh/sftp-server
ClientAliveInterval 300
ClientAliveCountMax 2
