theme = Retro
background-opacity = 0.90
background-opacity-cells = true
background-blur = true
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 10.5
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
cursor-style = block
cursor-style-blink = false
cursor-opacity = 0.90
mouse-hide-while-typing = true

# Override Retro's monochrome-green palette so colored apps (btm,
# htop, vim, etc.) don't render all-green.  Classic VGA/CGA palette.
palette = 0=#000000
palette = 1=#aa0000
palette = 2=#00aa00
palette = 3=#aa5500
palette = 4=#0000aa
palette = 5=#aa00aa
palette = 6=#00aaaa
palette = 7=#aaaaaa
palette = 8=#555555
palette = 9=#ff5555
palette = 10=#55ff55
palette = 11=#ffff55
palette = 12=#5555ff
palette = 13=#ff55ff
palette = 14=#55ffff
palette = 15=#ffffff

